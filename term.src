// machin-terminal — step 3: a VT100/xterm-subset terminal in pure MFL.
//
//   PTY (forkpty bash, non-blocking)  ->  VT escape parser  ->  raylib glyph grid
//   keystroke -> byte encoder  ->  PTY ;  window resize -> ioctl(TIOCSWINSZ)
//
// Over step 2 this adds the machinery full-screen TUIs need:
//   * alt-screen buffer (DEC ?47/?1047/?1049) — vim/htop/less stop corrupting scrollback
//   * scroll region (DECSTBM, CSI r) + IND/RI/NEL, scroll up/down (SU/SD)
//   * insert/delete lines (IL/DL) and chars (ICH/DCH/ECH)
//   * save/restore cursor (DECSC/DECRC = ESC 7/8, CSI s/u, ?1048)
//   * reverse video (SGR 7/27), cursor visibility (?25), app cursor keys (?1)
//   * a resizable window: recompute rows/cols and SIGWINCH the shell via ioctl
//
//   build:  ./build.sh     run:  DISPLAY=:0 ./machin-terminal

extern "raylib" {
	cflags "-I/tmp/rl/raylib-5.0_linux_amd64/include -L/tmp/rl/raylib-5.0_linux_amd64/lib"
	header "raylib.h"
	link ":libraylib.a"
	link "m"
	link "pthread"
	link "dl"
	link "rt"
	link "X11"
	link "GL"
	cstruct Color { r u8 g u8 b u8 a u8 }
	cstruct Vector2 { x f32 y f32 }
	cstruct Font {}
	fn SetConfigFlags(i32)
	fn InitWindow(i32, i32, string)
	fn CloseWindow()
	fn WindowShouldClose() bool
	fn SetTargetFPS(i32)
	fn SetWindowSize(i32, i32)
	fn GetScreenWidth() i32
	fn GetScreenHeight() i32
	fn BeginDrawing()
	fn EndDrawing()
	fn ClearBackground(Color)
	fn DrawRectangle(i32, i32, i32, i32, Color)
	fn LoadFontEx(string, i32, ptr, i32) Font
	fn MeasureTextEx(Font, string, f32, f32) Vector2
	fn DrawTextCodepoint(Font, i32, Vector2, f32, Color)
	fn GetCharPressed() i32
	fn IsKeyPressed(i32) bool
	fn IsKeyDown(i32) bool
	fn GetMouseX() i32
	fn GetMouseY() i32
	fn IsMouseButtonPressed(i32) bool
	fn IsMouseButtonReleased(i32) bool
	fn IsMouseButtonDown(i32) bool
	fn GetMouseWheelMove() f32
	fn SetClipboardText(ptr)
	fn GetClipboardText() ptr
}

extern "pty" { cflags "-lutil" header "pty.h" fn forkpty(ptr, ptr, ptr, ptr) i32 }
extern "uc" { header "unistd.h" fn read(i32, ptr, i32) i32 fn write(i32, ptr, i32) i32 fn execvp(string, ptr) i32 fn _exit(i32) }
extern "fc" { header "fcntl.h" fn fcntl(i32, i32, i32) i32 }
extern "wt" { header "sys/wait.h" fn waitpid(i32, ptr, i32) i32 }
extern "io" { header "sys/ioctl.h" fn ioctl(i32, i32, ptr) i32 }
extern "se" { header "stdlib.h" fn setenv(string, string, i32) i32 }

type Term struct {
	cols int
	rows int
	cx int
	cy int
	fg int
	bg int
	bold int
	rev int
	curvis int
	appcur int
	mtrack int
	msgr int
	bpaste int
	lastcol int
	lastrow int
	selActive int
	selecting int
	sr0 int
	sc0 int
	sr1 int
	sc1 int
	alt int
	top int
	bot int
	ch []int
	cfg []int
	cbg []int
	mch []int
	mcfg []int
	mcbg []int
	ach []int
	acfg []int
	acbg []int
	rmap []int
	mrmap []int
	armap []int
	st int
	u8need int
	u8cp int
	oscbuf int
	osclen int
	params []int
	cur int
	has int
	priv int
	savcx int
	savcy int
	savfg int
	savbg int
	savbold int
	savrev int
	master int
	pid int
}

var T = Term{}
var FS = 20.0
var DEF_FG = 0xd3d7cf
var DEF_BG = 0x000000
var PAL = []int{}
var RBUF = 0
var KBUF = 0
var WSTAT = 0
var WSZ = 0

func cstr(s) (p) {
	n := len(s)
	b := bytes(s)
	p = alloc(n + 1)
	i := 0
	for i < n {
		poke_u8(p, i, byte_at(b, i))
		i = i + 1
	}
	poke_u8(p, n, 0)
}

func mx(a, b) (v) {
	if a > b {
		v = a
	} else {
		v = b
	}
}

func clampi(v, lo, hi) (o) {
	o = v
	if o < lo {
		o = lo
	}
	if o > hi {
		o = hi
	}
}

func pn(i, def) (v) {
	if i < len(T.params) {
		v = T.params[i]
	} else {
		v = def
	}
}

func initPalette() {
	PAL = []int{0x000000, 0xcc0000, 0x4e9a06, 0xc4a000, 0x3465a4, 0x75507b, 0x06989a, 0xd3d7cf, 0x555753, 0xef2929, 0x8ae234, 0xfce94f, 0x729fcf, 0xad7fa8, 0x34e2e2, 0xeeeeec}
}

func zeros(n) (s) {
	s = []int{}
	i := 0
	for i < n {
		s = append(s, 0)
		i = i + 1
	}
}

func appendRange(s, lo, hi) (out) {
	out = s
	c := lo
	for c <= hi {
		out = append(out, c)
		c = c + 1
	}
}

func appendStrBytes(arr, s) (out) {
	out = arr
	b := bytes(s)
	m := len(s)
	i := 0
	for i < m {
		out = append(out, byte_at(b, i))
		i = i + 1
	}
}

func appendCSI(arr, params, final) (out) {
	out = append(arr, 27)
	out = append(out, 91)
	out = appendStrBytes(out, params)
	out = append(out, final)
}

// Headless VT-parser throughput benchmark (MTERM_BENCH=1). Feeds a representative
// colored-shell-output stream through the real feed() — including grid writes and
// scroll — so it measures the actual emulator engine, not a toy loop. No window.
func runBench() {
	mode := env("MTERM_BENCH")
	pat := []int{}
	if mode == "2" {
		// parse-bound: cursor-home each iter, no newline -> no scroll
		pat = appendCSI(pat, "", 72)
		pat = appendCSI(pat, "1;32", 109)
		pat = appendStrBytes(pat, "user@host")
		pat = appendCSI(pat, "0", 109)
		pat = appendStrBytes(pat, ":")
		pat = appendCSI(pat, "34", 109)
		pat = appendStrBytes(pat, "~/work/machin-terminal")
		pat = appendCSI(pat, "0", 109)
		pat = appendStrBytes(pat, "$ the quick brown fox 0123456789")
	} else {
		// realistic (cat-like): colored prompt line + text + CRLF (scrolls)
		pat = appendCSI(pat, "1;32", 109)
		pat = appendStrBytes(pat, "user@host")
		pat = appendCSI(pat, "0", 109)
		pat = appendStrBytes(pat, ":")
		pat = appendCSI(pat, "34", 109)
		pat = appendStrBytes(pat, "~/work/machin-terminal")
		pat = appendCSI(pat, "0", 109)
		pat = appendStrBytes(pat, "$ the quick brown fox jumps over 0123456789 ")
		pat = append(pat, 13)
		pat = append(pat, 10)
	}
	plen := len(pat)

	target := 50000000
	t0 := now_ms()
	fed := 0
	for fed < target {
		j := 0
		for j < plen {
			feed(pat[j])
			j = j + 1
		}
		fed = fed + plen
	}
	t1 := now_ms()
	ms := t1 - t0
	if ms < 1 {
		ms = 1
	}
	println("== machin-terminal VT parser throughput ==")
	println("bytes fed   : ", fed)
	println("elapsed (ms): ", ms)
	println("throughput  : ", fed/(ms*1000), " MB/s")
	println("per byte    : ", (ms*1000000)/fed, " ns/byte")
}

// Headless correctness check (MTERM_VERIFY=1): feed numbered lines 1..N through the
// real parser, then dump the LOGICAL grid (via rowbase) so scroll ordering can be
// verified without a window. Correct output shows consecutive numbers, in order.
func dumpGrid() {
	buf := alloc(T.cols + 1)
	r := 0
	for r < T.rows {
		base := rowbase(r)
		c := 0
		last := -1
		for c < T.cols {
			cp := T.ch[base+c]
			v := cp
			if v < 32 || v > 126 {
				v = 32
			}
			poke_u8(buf, c, v)
			if cp != 32 {
				last = c
			}
			c = c + 1
		}
		poke_u8(buf, last+1, 0)
		println("row ", r, ": ", ptr_str(buf))
		r = r + 1
	}
}

func runVerify() {
	i := 1
	for i <= 60 {
		s := str(i)
		b := bytes(s)
		m := len(s)
		j := 0
		for j < m {
			feed(byte_at(b, j))
			j = j + 1
		}
		feed(13)
		feed(10)
		i = i + 1
	}
	dumpGrid()
	// exercise selection extraction headlessly: select rows 0..2, last row to col 1
	T.selActive = 1
	T.sr0 = 0
	T.sc0 = 0
	T.sr1 = 2
	T.sc1 = 1
	sbuf := alloc(T.rows*T.cols*4 + T.rows + 1)
	soff := selToBuf(sbuf)
	poke_u8(sbuf, soff, 0)
	println("SELECTION rows0-2 (last@col1) -> ", ptr_str(sbuf))

	// OSC palette/default-color parsing
	feed(27)
	feedStr("]4;1;#ff8800")
	feed(7)
	feed(27)
	feedStr("]11;rgb:1a2b/3c4d/5e6f")
	feed(7)
	feed(27)
	feedStr("]10;#aabbcc")
	feed(7)
	println("OSC4  PAL[1] -> ", PAL[1], " want ", 0xff8800)
	println("OSC11 DEF_BG -> ", DEF_BG, " want ", 0x1a3c5e)
	println("OSC10 DEF_FG -> ", DEF_FG, " want ", 0xaabbcc)
}

func feedStr(s) {
	b := bytes(s)
	m := len(s)
	i := 0
	for i < m {
		feed(byte_at(b, i))
		i = i + 1
	}
}

// Codepoints to bake into the font atlas: ASCII + Latin-1, general punctuation
// (dashes/quotes/bullets), arrows, box-drawing + block elements + geometric shapes
// (tmux/TUI borders), and Braille (spinners/btop). Anything else renders as '?'.
func buildCodepoints() (buf, count) {
	cps := []int{}
	cps = appendRange(cps, 0x20, 0xFF)
	cps = appendRange(cps, 0x2010, 0x2027)
	cps = appendRange(cps, 0x2190, 0x21FF)
	cps = appendRange(cps, 0x2500, 0x25FF)
	cps = appendRange(cps, 0x2800, 0x28FF)
	cps = appendRange(cps, 0xE000, 0xE0FF)
	count = len(cps)
	buf = alloc(count * 4)
	i := 0
	for i < count {
		poke_i32(buf, i*4, cps[i])
		i = i + 1
	}
}

func rgb3(r, g, b) (v) {
	v = ((r & 255) << 16) | ((g & 255) << 8) | (b & 255)
}

func xterm256(n) (rgb) {
	if n < 16 {
		rgb = PAL[n]
	} else if n < 232 {
		m := n - 16
		r := m / 36
		g := (m / 6) % 6
		b := m % 6
		rr := 0
		gg := 0
		bb := 0
		if r > 0 {
			rr = r * 40 + 55
		}
		if g > 0 {
			gg = g * 40 + 55
		}
		if b > 0 {
			bb = b * 40 + 55
		}
		rgb = (rr << 16) | (gg << 8) | bb
	} else {
		v := (n - 232) * 10 + 8
		rgb = (v << 16) | (v << 8) | v
	}
}

// Row indirection: logical row r lives at physical base rowbase(r). Scrolling rotates
// T.rmap (O(rows)) instead of copying every cell (O(rows*cols)).
func rowbase(r) (b) {
	b = T.rmap[r] * T.cols
}

func identityRows() (m) {
	m = []int{}
	r := 0
	for r < T.rows {
		m = append(m, r)
		r = r + 1
	}
}

func resetActiveRmap() {
	r := 0
	for r < T.rows {
		T.rmap[r] = r
		r = r + 1
	}
}

func hexNibble(ch) (v) {
	if ch >= 48 && ch <= 57 {
		v = ch - 48
	} else if ch >= 97 && ch <= 102 {
		v = ch - 87
	} else if ch >= 65 && ch <= 70 {
		v = ch - 55
	} else {
		v = -1
	}
}

func parseHexN(b, start, n) (v) {
	v = 0
	i := 0
	for i < n {
		d := hexNibble(byte_at(b, start+i))
		if d < 0 {
			v = -1
			return
		}
		v = v*16 + d
		i = i + 1
	}
}

// Read one hex channel from bytes b at start, up to '/' or end; scale to 8-bit.
func readChannel(b, start, m) (val, nxt) {
	v := 0
	cnt := 0
	i := start
	for i < m {
		ch := byte_at(b, i)
		if ch == 47 {
			break
		}
		d := hexNibble(ch)
		if d < 0 {
			val = -1
			nxt = m
			return
		}
		v = v*16 + d
		cnt = cnt + 1
		i = i + 1
	}
	if cnt == 2 {
		val = v
	} else if cnt == 4 {
		val = v >> 8
	} else if cnt == 1 {
		val = v * 17
	} else if cnt == 3 {
		val = v >> 4
	} else {
		val = v & 255
	}
	nxt = i + 1
}

// Parse an X11 color spec ("#RRGGBB", "#RGB", "rgb:RR/GG/BB", "rgb:RRRR/GGGG/BBBB")
// into a 0xRRGGBB int, or -1 if unrecognized (e.g. a "?" query).
func parseColorSpec(spec) (rgb) {
	rgb = -1
	m := len(spec)
	if m == 0 {
		return
	}
	b := bytes(spec)
	c0 := byte_at(b, 0)
	if c0 == 35 {
		if m == 7 {
			r := parseHexN(b, 1, 2)
			g := parseHexN(b, 3, 2)
			bl := parseHexN(b, 5, 2)
			if r >= 0 && g >= 0 && bl >= 0 {
				rgb = (r << 16) | (g << 8) | bl
			}
		} else if m == 4 {
			r := parseHexN(b, 1, 1)
			g := parseHexN(b, 2, 1)
			bl := parseHexN(b, 3, 1)
			if r >= 0 && g >= 0 && bl >= 0 {
				rgb = ((r * 17) << 16) | ((g * 17) << 8) | (bl * 17)
			}
		}
	} else if m >= 5 && c0 == 114 && byte_at(b, 1) == 103 && byte_at(b, 2) == 98 && byte_at(b, 3) == 58 {
		r, p := readChannel(b, 4, m)
		g, p2 := readChannel(b, p, m)
		bl, p3 := readChannel(b, p2, m)
		if r >= 0 && g >= 0 && bl >= 0 && p3 >= 0 {
			rgb = (r << 16) | (g << 8) | bl
		}
	}
}

// OSC handler: 4;idx;spec (palette), 10;spec (default fg), 11;spec (default bg).
// This is how shell-side theme scripts (base16-shell, omz) set the terminal palette.
func oscDispatch() {
	poke_u8(T.oscbuf, T.osclen, 0)
	s := ptr_str(T.oscbuf)
	parts := split(s, ";")
	if len(parts) < 2 {
		return
	}
	ps := parts[0]
	if ps == "4" {
		i := 1
		for i+1 < len(parts) {
			idx := parse_int(parts[i])
			rgb := parseColorSpec(parts[i+1])
			if rgb >= 0 && idx >= 0 && idx < 16 {
				PAL[idx] = rgb
			}
			i = i + 2
		}
	} else if ps == "10" {
		rgb := parseColorSpec(parts[1])
		if rgb >= 0 {
			DEF_FG = rgb
		}
	} else if ps == "11" {
		rgb := parseColorSpec(parts[1])
		if rgb >= 0 {
			DEF_BG = rgb
		}
	}
}

func blankCell(i) {
	T.ch[i] = 32
	T.cfg[i] = T.fg
	T.cbg[i] = T.bg
}

func clearRow(r) {
	base := rowbase(r)
	c := 0
	for c < T.cols {
		blankCell(base + c)
		c = c + 1
	}
}

func clearAll() {
	tot := T.rows * T.cols
	i := 0
	for i < tot {
		blankCell(i)
		i = i + 1
	}
}

func copyRow(src, dst) {
	s := rowbase(src)
	d := rowbase(dst)
	c := 0
	for c < T.cols {
		T.ch[d+c] = T.ch[s+c]
		T.cfg[d+c] = T.cfg[s+c]
		T.cbg[d+c] = T.cbg[s+c]
		c = c + 1
	}
}

func eraseLineFrom(row, s, e) {
	base := rowbase(row)
	c := s
	for c < e {
		blankCell(base + c)
		c = c + 1
	}
}

func scrollRegionUp(n) {
	h := T.bot - T.top + 1
	if n >= h {
		r := T.top
		for r <= T.bot {
			clearRow(r)
			r = r + 1
		}
		return
	}
	// rotate the region's row pointers up by n; recycle the top n rows to the bottom
	tmp := []int{}
	i := 0
	for i < n {
		tmp = append(tmp, T.rmap[T.top+i])
		i = i + 1
	}
	r := T.top
	for r <= T.bot-n {
		T.rmap[r] = T.rmap[r+n]
		r = r + 1
	}
	i = 0
	for i < n {
		T.rmap[T.bot-n+1+i] = tmp[i]
		clearRow(T.bot - n + 1 + i)
		i = i + 1
	}
}

func scrollRegionDown(n) {
	h := T.bot - T.top + 1
	if n >= h {
		r := T.top
		for r <= T.bot {
			clearRow(r)
			r = r + 1
		}
		return
	}
	tmp := []int{}
	i := 0
	for i < n {
		tmp = append(tmp, T.rmap[T.bot-n+1+i])
		i = i + 1
	}
	r := T.bot
	for r >= T.top+n {
		T.rmap[r] = T.rmap[r-n]
		r = r - 1
	}
	i = 0
	for i < n {
		T.rmap[T.top+i] = tmp[i]
		clearRow(T.top + i)
		i = i + 1
	}
}

func insertLines(n) {
	if T.cy < T.top || T.cy > T.bot {
		return
	}
	k := 0
	for k < n {
		r := T.bot
		for r > T.cy {
			copyRow(r-1, r)
			r = r - 1
		}
		clearRow(T.cy)
		k = k + 1
	}
}

func deleteLines(n) {
	if T.cy < T.top || T.cy > T.bot {
		return
	}
	k := 0
	for k < n {
		r := T.cy
		for r < T.bot {
			copyRow(r+1, r)
			r = r + 1
		}
		clearRow(T.bot)
		k = k + 1
	}
}

func insertChars(n) {
	base := rowbase(T.cy)
	c := T.cols - 1
	for c >= T.cx+n {
		T.ch[base+c] = T.ch[base+c-n]
		T.cfg[base+c] = T.cfg[base+c-n]
		T.cbg[base+c] = T.cbg[base+c-n]
		c = c - 1
	}
	lim := T.cx + n
	if lim > T.cols {
		lim = T.cols
	}
	c = T.cx
	for c < lim {
		blankCell(base + c)
		c = c + 1
	}
}

func deleteChars(n) {
	base := rowbase(T.cy)
	c := T.cx
	for c < T.cols {
		if c+n < T.cols {
			T.ch[base+c] = T.ch[base+c+n]
			T.cfg[base+c] = T.cfg[base+c+n]
			T.cbg[base+c] = T.cbg[base+c+n]
		} else {
			blankCell(base + c)
		}
		c = c + 1
	}
}

func eraseChars(n) {
	base := rowbase(T.cy)
	lim := T.cx + n
	if lim > T.cols {
		lim = T.cols
	}
	c := T.cx
	for c < lim {
		blankCell(base + c)
		c = c + 1
	}
}

func lf() {
	if T.cy == T.bot {
		scrollRegionUp(1)
	} else if T.cy < T.rows-1 {
		T.cy = T.cy + 1
	}
}

func ri() {
	if T.cy == T.top {
		scrollRegionDown(1)
	} else if T.cy > 0 {
		T.cy = T.cy - 1
	}
}

func putc(cp) {
	fg := T.fg
	bg := T.bg
	if T.rev == 1 {
		fg = T.bg
		bg = T.fg
	}
	i := rowbase(T.cy) + T.cx
	T.ch[i] = cp
	T.cfg[i] = fg
	T.cbg[i] = bg
	T.cx = T.cx + 1
	if T.cx >= T.cols {
		T.cx = 0
		lf()
	}
}

func tab() {
	T.cx = ((T.cx / 8) + 1) * 8
	if T.cx >= T.cols {
		T.cx = T.cols - 1
	}
}

func eraseDisp(mode) {
	if mode == 0 {
		eraseLineFrom(T.cy, T.cx, T.cols)
		r := T.cy + 1
		for r < T.rows {
			clearRow(r)
			r = r + 1
		}
	} else if mode == 1 {
		r := 0
		for r < T.cy {
			clearRow(r)
			r = r + 1
		}
		eraseLineFrom(T.cy, 0, T.cx+1)
	} else {
		r := 0
		for r < T.rows {
			clearRow(r)
			r = r + 1
		}
	}
}

func eraseLine(mode) {
	if mode == 1 {
		eraseLineFrom(T.cy, 0, T.cx+1)
	} else if mode == 2 {
		eraseLineFrom(T.cy, 0, T.cols)
	} else {
		eraseLineFrom(T.cy, T.cx, T.cols)
	}
}

func sgr() {
	np := len(T.params)
	if np == 0 {
		T.fg = DEF_FG
		T.bg = DEF_BG
		T.bold = 0
		T.rev = 0
		return
	}
	i := 0
	for i < np {
		v := T.params[i]
		if v == 0 {
			T.fg = DEF_FG
			T.bg = DEF_BG
			T.bold = 0
			T.rev = 0
		} else if v == 1 {
			T.bold = 1
		} else if v == 7 {
			T.rev = 1
		} else if v == 22 {
			T.bold = 0
		} else if v == 27 {
			T.rev = 0
		} else if v >= 30 && v <= 37 {
			k := v - 30
			if T.bold == 1 {
				k = k + 8
			}
			T.fg = PAL[k]
		} else if v == 39 {
			T.fg = DEF_FG
		} else if v >= 40 && v <= 47 {
			T.bg = PAL[v-40]
		} else if v == 49 {
			T.bg = DEF_BG
		} else if v >= 90 && v <= 97 {
			T.fg = PAL[v-90+8]
		} else if v >= 100 && v <= 107 {
			T.bg = PAL[v-100+8]
		} else if v == 38 {
			if i+2 < np && T.params[i+1] == 5 {
				T.fg = xterm256(T.params[i+2])
				i = i + 2
			} else if i+4 < np && T.params[i+1] == 2 {
				T.fg = rgb3(T.params[i+2], T.params[i+3], T.params[i+4])
				i = i + 4
			}
		} else if v == 48 {
			if i+2 < np && T.params[i+1] == 5 {
				T.bg = xterm256(T.params[i+2])
				i = i + 2
			} else if i+4 < np && T.params[i+1] == 2 {
				T.bg = rgb3(T.params[i+2], T.params[i+3], T.params[i+4])
				i = i + 4
			}
		}
		i = i + 1
	}
}

func saveCursor() {
	T.savcx = T.cx
	T.savcy = T.cy
	T.savfg = T.fg
	T.savbg = T.bg
	T.savbold = T.bold
	T.savrev = T.rev
}

func restoreCursor() {
	T.cx = T.savcx
	T.cy = T.savcy
	T.fg = T.savfg
	T.bg = T.savbg
	T.bold = T.savbold
	T.rev = T.savrev
}

func altSwitch(on) {
	if on == true {
		if T.alt == 1 {
			return
		}
		T.alt = 1
		T.ch = T.ach
		T.cfg = T.acfg
		T.cbg = T.acbg
		T.rmap = T.armap
	} else {
		if T.alt == 0 {
			return
		}
		T.alt = 0
		T.ch = T.mch
		T.cfg = T.mcfg
		T.cbg = T.mcbg
		T.rmap = T.mrmap
	}
}

func privMode(b) {
	set := b == 104
	p := pn(0, 0)
	if p == 25 {
		if set {
			T.curvis = 1
		} else {
			T.curvis = 0
		}
	} else if p == 1 {
		if set {
			T.appcur = 1
		} else {
			T.appcur = 0
		}
	} else if p == 1000 {
		if set {
			T.mtrack = 1
		} else {
			T.mtrack = 0
		}
	} else if p == 1002 {
		if set {
			T.mtrack = 2
		} else {
			T.mtrack = 0
		}
	} else if p == 1003 {
		if set {
			T.mtrack = 3
		} else {
			T.mtrack = 0
		}
	} else if p == 1006 {
		if set {
			T.msgr = 1
		} else {
			T.msgr = 0
		}
	} else if p == 2004 {
		if set {
			T.bpaste = 1
		} else {
			T.bpaste = 0
		}
	} else if p == 47 || p == 1047 {
		if set {
			altSwitch(true)
			resetActiveRmap()
			clearAll()
			T.cx = 0
			T.cy = 0
		} else {
			altSwitch(false)
		}
	} else if p == 1048 {
		if set {
			saveCursor()
		} else {
			restoreCursor()
		}
	} else if p == 1049 {
		if set {
			saveCursor()
			altSwitch(true)
			resetActiveRmap()
			clearAll()
			T.cx = 0
			T.cy = 0
		} else {
			altSwitch(false)
			restoreCursor()
		}
	}
}

func csiDispatch(b) {
	if T.priv == 1 {
		privMode(b)
		return
	}
	p0 := pn(0, 0)
	if b == 109 {
		sgr()
	} else if b == 72 || b == 102 {
		r := pn(0, 1)
		c := pn(1, 1)
		if r < 1 {
			r = 1
		}
		if c < 1 {
			c = 1
		}
		T.cy = clampi(r-1, 0, T.rows-1)
		T.cx = clampi(c-1, 0, T.cols-1)
	} else if b == 65 {
		T.cy = clampi(T.cy-mx(1, p0), 0, T.rows-1)
	} else if b == 66 {
		T.cy = clampi(T.cy+mx(1, p0), 0, T.rows-1)
	} else if b == 67 {
		T.cx = clampi(T.cx+mx(1, p0), 0, T.cols-1)
	} else if b == 68 {
		T.cx = clampi(T.cx-mx(1, p0), 0, T.cols-1)
	} else if b == 71 {
		T.cx = clampi(mx(1, p0)-1, 0, T.cols-1)
	} else if b == 100 {
		T.cy = clampi(mx(1, p0)-1, 0, T.rows-1)
	} else if b == 74 {
		eraseDisp(p0)
	} else if b == 75 {
		eraseLine(p0)
	} else if b == 114 {
		t := pn(0, 1)
		bb := pn(1, T.rows)
		if t < 1 {
			t = 1
		}
		if bb > T.rows {
			bb = T.rows
		}
		if t < bb {
			T.top = t - 1
			T.bot = bb - 1
			T.cx = 0
			T.cy = T.top
		}
	} else if b == 76 {
		insertLines(mx(1, p0))
	} else if b == 77 {
		deleteLines(mx(1, p0))
	} else if b == 64 {
		insertChars(mx(1, p0))
	} else if b == 80 {
		deleteChars(mx(1, p0))
	} else if b == 88 {
		eraseChars(mx(1, p0))
	} else if b == 83 {
		scrollRegionUp(mx(1, p0))
	} else if b == 84 {
		scrollRegionDown(mx(1, p0))
	} else if b == 115 {
		saveCursor()
	} else if b == 117 {
		restoreCursor()
	}
}

func feed(b) {
	if T.st == 0 {
		if b >= 0x80 {
			if b >= 0xC0 {
				if b >= 0xF0 {
					T.u8need = 3
					T.u8cp = b & 0x07
				} else if b >= 0xE0 {
					T.u8need = 2
					T.u8cp = b & 0x0F
				} else {
					T.u8need = 1
					T.u8cp = b & 0x1F
				}
			} else if T.u8need > 0 {
				T.u8cp = (T.u8cp << 6) | (b & 0x3F)
				T.u8need = T.u8need - 1
				if T.u8need == 0 {
					putc(T.u8cp)
				}
			}
		} else if b == 27 {
			T.u8need = 0
			T.st = 1
		} else if b == 10 {
			T.u8need = 0
			lf()
		} else if b == 13 {
			T.u8need = 0
			T.cx = 0
		} else if b == 8 {
			T.u8need = 0
			if T.cx > 0 {
				T.cx = T.cx - 1
			}
		} else if b == 9 {
			T.u8need = 0
			tab()
		} else if b == 7 {
			T.u8need = 0
		} else if b >= 32 {
			T.u8need = 0
			putc(b)
		}
	} else if T.st == 1 {
		if b == 91 {
			T.st = 2
			T.params = []int{}
			T.cur = 0
			T.has = 0
			T.priv = 0
		} else if b == 93 {
			T.st = 3
			T.osclen = 0
		} else if b == 40 || b == 41 {
			T.st = 4
		} else if b == 55 {
			saveCursor()
			T.st = 0
		} else if b == 56 {
			restoreCursor()
			T.st = 0
		} else if b == 77 {
			ri()
			T.st = 0
		} else if b == 68 {
			lf()
			T.st = 0
		} else if b == 69 {
			T.cx = 0
			lf()
			T.st = 0
		} else {
			T.st = 0
		}
	} else if T.st == 2 {
		if b >= 48 && b <= 57 {
			T.cur = T.cur*10 + (b - 48)
			T.has = 1
		} else if b == 59 {
			T.params = append(T.params, T.cur)
			T.cur = 0
			T.has = 0
		} else if b == 63 {
			T.priv = 1
		} else if b >= 64 && b <= 126 {
			T.params = append(T.params, T.cur)
			csiDispatch(b)
			T.st = 0
		}
	} else if T.st == 3 {
		if b == 7 {
			oscDispatch()
			T.st = 0
		} else if b == 27 {
			T.st = 5
		} else if T.osclen < 4095 {
			poke_u8(T.oscbuf, T.osclen, b)
			T.osclen = T.osclen + 1
		}
	} else if T.st == 4 {
		T.st = 0
	} else if T.st == 5 {
		oscDispatch()
		T.st = 0
	}
}

func drainPty() {
	loops := 0
	for loops < 512 {
		n := read(T.master, RBUF, 4096)
		if n <= 0 {
			return
		}
		i := 0
		for i < n {
			base := i - (i & 3)
			w := peek_i32(RBUF, base)
			sh := (i & 3) * 8
			feed((w >> sh) & 255)
			i = i + 1
		}
		loops = loops + 1
	}
}

func sendByte(b) {
	poke_u8(KBUF, 0, b & 255)
	write(T.master, KBUF, 1)
}

func sendArrow(f) {
	poke_u8(KBUF, 0, 27)
	if T.appcur == 1 {
		poke_u8(KBUF, 1, 79)
	} else {
		poke_u8(KBUF, 1, 91)
	}
	poke_u8(KBUF, 2, f)
	write(T.master, KBUF, 3)
}

func sendDel() {
	poke_u8(KBUF, 0, 27)
	poke_u8(KBUF, 1, 91)
	poke_u8(KBUF, 2, 51)
	poke_u8(KBUF, 3, 126)
	write(T.master, KBUF, 4)
}

func sendCp(c) {
	if c < 0x80 {
		poke_u8(KBUF, 0, c)
		write(T.master, KBUF, 1)
	} else if c < 0x800 {
		poke_u8(KBUF, 0, 0xC0|(c>>6))
		poke_u8(KBUF, 1, 0x80|(c&0x3F))
		write(T.master, KBUF, 2)
	} else if c < 0x10000 {
		poke_u8(KBUF, 0, 0xE0|(c>>12))
		poke_u8(KBUF, 1, 0x80|((c>>6)&0x3F))
		poke_u8(KBUF, 2, 0x80|(c&0x3F))
		write(T.master, KBUF, 3)
	} else {
		poke_u8(KBUF, 0, 0xF0|(c>>18))
		poke_u8(KBUF, 1, 0x80|((c>>12)&0x3F))
		poke_u8(KBUF, 2, 0x80|((c>>6)&0x3F))
		poke_u8(KBUF, 3, 0x80|(c&0x3F))
		write(T.master, KBUF, 4)
	}
}

func pokeNum(off, n) (no) {
	s := str(n)
	b := bytes(s)
	m := len(s)
	i := 0
	for i < m {
		poke_u8(KBUF, off+i, byte_at(b, i))
		i = i + 1
	}
	no = off + m
}

// Encode one mouse event to the PTY. cb = xterm button code (incl. modifier/motion
// bits already added); press = 1 for press/motion (final 'M'), 0 for release ('m').
func sendMouse(cb, col, row, press) {
	if T.msgr == 1 {
		o := 0
		poke_u8(KBUF, o, 27)
		o = o + 1
		poke_u8(KBUF, o, 91)
		o = o + 1
		poke_u8(KBUF, o, 60)
		o = o + 1
		o = pokeNum(o, cb)
		poke_u8(KBUF, o, 59)
		o = o + 1
		o = pokeNum(o, col+1)
		poke_u8(KBUF, o, 59)
		o = o + 1
		o = pokeNum(o, row+1)
		if press == 1 {
			poke_u8(KBUF, o, 77)
		} else {
			poke_u8(KBUF, o, 109)
		}
		o = o + 1
		write(T.master, KBUF, o)
	} else {
		cbx := cb
		if press == 0 {
			cbx = 3
		}
		poke_u8(KBUF, 0, 27)
		poke_u8(KBUF, 1, 91)
		poke_u8(KBUF, 2, 77)
		poke_u8(KBUF, 3, clampi(cbx+32, 0, 255))
		poke_u8(KBUF, 4, clampi(col+1+32, 0, 255))
		poke_u8(KBUF, 5, clampi(row+1+32, 0, 255))
		write(T.master, KBUF, 6)
	}
}

func mouseMods() (m) {
	m = 0
	if IsKeyDown(340) || IsKeyDown(344) {
		m = m + 4
	}
	if IsKeyDown(342) || IsKeyDown(346) {
		m = m + 8
	}
	if IsKeyDown(341) || IsKeyDown(345) {
		m = m + 16
	}
}

func utf8Into(buf, off, cp) (no) {
	if cp < 0x80 {
		poke_u8(buf, off, cp)
		no = off + 1
	} else if cp < 0x800 {
		poke_u8(buf, off, 0xC0|(cp>>6))
		poke_u8(buf, off+1, 0x80|(cp&0x3F))
		no = off + 2
	} else if cp < 0x10000 {
		poke_u8(buf, off, 0xE0|(cp>>12))
		poke_u8(buf, off+1, 0x80|((cp>>6)&0x3F))
		poke_u8(buf, off+2, 0x80|(cp&0x3F))
		no = off + 3
	} else {
		poke_u8(buf, off, 0xF0|(cp>>18))
		poke_u8(buf, off+1, 0x80|((cp>>12)&0x3F))
		poke_u8(buf, off+2, 0x80|((cp>>6)&0x3F))
		poke_u8(buf, off+3, 0x80|(cp&0x3F))
		no = off + 4
	}
}

// True if logical cell (r,c) falls within the current linear selection.
func inSel(r, c) (yes) {
	yes = false
	if T.selActive == 0 {
		return
	}
	r0 := T.sr0
	c0 := T.sc0
	r1 := T.sr1
	c1 := T.sc1
	if r1 < r0 || (r1 == r0 && c1 < c0) {
		r0 = T.sr1
		c0 = T.sc1
		r1 = T.sr0
		c1 = T.sc0
	}
	afterStart := r > r0 || (r == r0 && c >= c0)
	beforeEnd := r < r1 || (r == r1 && c <= c1)
	yes = afterStart && beforeEnd
}

// Build the current selection (linear, trailing spaces trimmed, \n between rows) into
// buf as UTF-8; returns the byte length (no NUL written).
func selToBuf(buf) (off) {
	off = 0
	r0 := T.sr0
	c0 := T.sc0
	r1 := T.sr1
	c1 := T.sc1
	if r1 < r0 || (r1 == r0 && c1 < c0) {
		r0 = T.sr1
		c0 = T.sc1
		r1 = T.sr0
		c1 = T.sc0
	}
	r := r0
	for r <= r1 {
		base := rowbase(r)
		cs := 0
		if r == r0 {
			cs = c0
		}
		ce := T.cols - 1
		if r == r1 {
			ce = c1
		}
		last := cs - 1
		c := cs
		for c <= ce {
			if T.ch[base+c] != 32 {
				last = c
			}
			c = c + 1
		}
		c = cs
		for c <= last {
			off = utf8Into(buf, off, T.ch[base+c])
			c = c + 1
		}
		if r < r1 {
			poke_u8(buf, off, 10)
			off = off + 1
		}
		r = r + 1
	}
}

// Copy the current selection to the system clipboard via raylib/GLFW.
func copySelection() {
	if T.selActive == 0 {
		return
	}
	buf := alloc(T.rows*T.cols*4 + T.rows + 1)
	off := selToBuf(buf)
	poke_u8(buf, off, 0)
	SetClipboardText(buf)
	free(buf)
}

func pasteClipboard() {
	p := GetClipboardText()
	if p == 0 {
		return
	}
	s := ptr_str(p)
	n := len(s)
	if n == 0 {
		return
	}
	b := bytes(s)
	buf := alloc(n + 16)
	off := 0
	if T.bpaste == 1 {
		off = utf8Into(buf, off, 27)
		poke_u8(buf, off, 91)
		poke_u8(buf, off+1, 50)
		poke_u8(buf, off+2, 48)
		poke_u8(buf, off+3, 48)
		poke_u8(buf, off+4, 126)
		off = off + 5
	}
	i := 0
	for i < n {
		poke_u8(buf, off, byte_at(b, i))
		off = off + 1
		i = i + 1
	}
	if T.bpaste == 1 {
		poke_u8(buf, off, 27)
		poke_u8(buf, off+1, 91)
		poke_u8(buf, off+2, 50)
		poke_u8(buf, off+3, 48)
		poke_u8(buf, off+4, 49)
		poke_u8(buf, off+5, 126)
		off = off + 6
	}
	write(T.master, buf, off)
	free(buf)
}

func handleMouse(cw, ch) {
	col := clampi(GetMouseX()/cw, 0, T.cols-1)
	row := clampi(GetMouseY()/ch, 0, T.rows-1)
	shift := IsKeyDown(340) || IsKeyDown(344)
	// App owns the mouse only if it asked for tracking AND Shift isn't forcing local
	// selection (the xterm convention).
	if T.mtrack == 0 || shift == true {
		if IsMouseButtonPressed(0) {
			T.sr0 = row
			T.sc0 = col
			T.sr1 = row
			T.sc1 = col
			T.selecting = 1
			T.selActive = 1
		}
		if T.selecting == 1 && IsMouseButtonDown(0) {
			T.sr1 = row
			T.sc1 = col
		}
		if IsMouseButtonReleased(0) {
			T.selecting = 0
			copySelection()
		}
		if IsMouseButtonPressed(2) {
			pasteClipboard()
		}
		return
	}
	mods := mouseMods()
	if IsMouseButtonPressed(0) {
		sendMouse(0+mods, col, row, 1)
	}
	if IsMouseButtonPressed(2) {
		sendMouse(1+mods, col, row, 1)
	}
	if IsMouseButtonPressed(1) {
		sendMouse(2+mods, col, row, 1)
	}
	if IsMouseButtonReleased(0) {
		sendMouse(0+mods, col, row, 0)
	}
	if IsMouseButtonReleased(2) {
		sendMouse(1+mods, col, row, 0)
	}
	if IsMouseButtonReleased(1) {
		sendMouse(2+mods, col, row, 0)
	}
	w := GetMouseWheelMove()
	if w > 0.0 {
		sendMouse(64+mods, col, row, 1)
	} else if w < 0.0 {
		sendMouse(65+mods, col, row, 1)
	}
	if T.mtrack >= 2 && (col != T.lastcol || row != T.lastrow) {
		held := -1
		if IsMouseButtonDown(0) {
			held = 0
		} else if IsMouseButtonDown(2) {
			held = 1
		} else if IsMouseButtonDown(1) {
			held = 2
		}
		if held >= 0 {
			sendMouse(held+32+mods, col, row, 1)
		} else if T.mtrack == 3 {
			sendMouse(35+mods, col, row, 1)
		}
	}
	T.lastcol = col
	T.lastrow = row
}

func handleInput() {
	for {
		c := GetCharPressed()
		if c == 0 {
			break
		}
		sendCp(c)
	}
	if IsKeyPressed(257) {
		sendByte(13)
	}
	if IsKeyPressed(259) {
		sendByte(127)
	}
	if IsKeyPressed(258) {
		sendByte(9)
	}
	if IsKeyPressed(256) {
		sendByte(27)
	}
	if IsKeyPressed(265) {
		sendArrow(65)
	}
	if IsKeyPressed(264) {
		sendArrow(66)
	}
	if IsKeyPressed(262) {
		sendArrow(67)
	}
	if IsKeyPressed(263) {
		sendArrow(68)
	}
	if IsKeyPressed(261) {
		sendDel()
	}
	ctrl := IsKeyDown(341) || IsKeyDown(345)
	shift := IsKeyDown(340) || IsKeyDown(344)
	if ctrl && shift {
		if IsKeyPressed(67) {
			copySelection()
		}
		if IsKeyPressed(86) {
			pasteClipboard()
		}
	} else if ctrl {
		k := 65
		for k <= 90 {
			if IsKeyPressed(k) {
				sendByte(k - 64)
			}
			k = k + 1
		}
	}
}

func colOf(rgb) (col) {
	col = Color{(rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, 255}
}

func drawGrid(font, cwf, chf, cw, ch) {
	BeginDrawing()
	ClearBackground(colOf(DEF_BG))
	r := 0
	for r < T.rows {
		rb := rowbase(r)
		c := 0
		for c < T.cols {
			i := rb + c
			sel := inSel(r, c)
			bgv := T.cbg[i]
			if sel == true {
				DrawRectangle(c*cw, r*ch, cw, ch, colOf(0x44475a))
			} else if bgv != DEF_BG {
				DrawRectangle(c*cw, r*ch, cw, ch, colOf(bgv))
			}
			cp := T.ch[i]
			if cp > 32 {
				DrawTextCodepoint(font, cp, Vector2{float(c) * cwf, float(r) * chf}, FS, colOf(T.cfg[i]))
			}
			c = c + 1
		}
		r = r + 1
	}
	if T.curvis == 1 {
		DrawRectangle(T.cx*cw, T.cy*ch+ch-2, cw, 2, colOf(0xd3d7cf))
	}
	EndDrawing()
}

func allocGrids() {
	tot := T.rows * T.cols
	T.mch = zeros(tot)
	T.mcfg = zeros(tot)
	T.mcbg = zeros(tot)
	T.ach = zeros(tot)
	T.acfg = zeros(tot)
	T.acbg = zeros(tot)
	i := 0
	for i < tot {
		T.mch[i] = 32
		T.mcfg[i] = DEF_FG
		T.mcbg[i] = DEF_BG
		T.ach[i] = 32
		T.acfg[i] = DEF_FG
		T.acbg[i] = DEF_BG
		i = i + 1
	}
	T.mrmap = identityRows()
	T.armap = identityRows()
	if T.alt == 1 {
		T.ch = T.ach
		T.cfg = T.acfg
		T.cbg = T.acbg
		T.rmap = T.armap
	} else {
		T.ch = T.mch
		T.cfg = T.mcfg
		T.cbg = T.mcbg
		T.rmap = T.mrmap
	}
}

func resizeTo(nc, nr) {
	T.cols = nc
	T.rows = nr
	T.top = 0
	T.bot = nr - 1
	if T.cx >= nc {
		T.cx = nc - 1
	}
	if T.cy >= nr {
		T.cy = nr - 1
	}
	allocGrids()
	poke_u16(WSZ, 0, T.rows)
	poke_u16(WSZ, 2, T.cols)
	ioctl(T.master, 21524, WSZ)
}

func checkResize(cw, ch) {
	nc := GetScreenWidth() / cw
	nr := GetScreenHeight() / ch
	if nc < 1 {
		nc = 1
	}
	if nr < 1 {
		nr = 1
	}
	if nc != T.cols || nr != T.rows {
		resizeTo(nc, nr)
	}
}

func main() {
	T.cols = 80
	T.rows = 24
	T.cx = 0
	T.cy = 0
	T.fg = DEF_FG
	T.bg = DEF_BG
	T.bold = 0
	T.rev = 0
	T.curvis = 1
	T.appcur = 0
	T.mtrack = 0
	T.msgr = 0
	T.bpaste = 0
	T.lastcol = 0
	T.lastrow = 0
	T.selActive = 0
	T.selecting = 0
	T.alt = 0
	T.top = 0
	T.bot = 23
	T.st = 0
	T.u8need = 0
	T.u8cp = 0
	T.priv = 0
	T.params = []int{}
	T.osclen = 0
	T.oscbuf = alloc(4096)
	fsz := env("MTERM_FONT_SIZE")
	if fsz != "" {
		FS = parse_float(fsz)
	}
	initPalette()
	allocGrids()

	if env("MTERM_BENCH") != "" {
		runBench()
		exit(0)
	}
	if env("MTERM_VERIFY") != "" {
		runVerify()
		exit(0)
	}

	amaster := alloc(8)
	ws := alloc(8)
	poke_u16(ws, 0, T.rows)
	poke_u16(ws, 2, T.cols)
	pid := forkpty(amaster, 0, 0, ws)
	if pid == 0 {
		setenv("TERM", "xterm-256color", 1)
		argv := alloc(16)
		poke_ptr(argv, 0, cstr("bash"))
		poke_ptr(argv, 8, 0)
		execvp("bash", argv)
		_exit(127)
	}
	T.master = peek_i32(amaster, 0)
	T.pid = pid
	fl := fcntl(T.master, 3, 0)
	fcntl(T.master, 4, fl|2048)
	RBUF = alloc(8192)
	KBUF = alloc(32)
	WSTAT = alloc(16)
	WSZ = alloc(8)

	sd := env("MTERM_SEED")
	if sd != "" {
		write(T.master, cstr(sd), len(sd))
	}

	SetConfigFlags(4)
	InitWindow(800, 480, "machin-terminal")
	SetTargetFPS(60)
	cpbuf, cpn := buildCodepoints()
	fontPath := env("MTERM_FONT")
	if fontPath == "" {
		fontPath = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
	}
	font := LoadFontEx(fontPath, int(FS), cpbuf, cpn)
	mv := MeasureTextEx(font, "M", FS, 0.0)
	cwf := mv.x
	chf := FS + 2.0
	cw := int(cwf)
	ch := int(chf)
	if cw < 1 {
		cw = 1
	}
	SetWindowSize(T.cols*cw, T.rows*ch)

	for {
		if WindowShouldClose() {
			break
		}
		if waitpid(T.pid, WSTAT, 1) == T.pid {
			break
		}
		checkResize(cw, ch)
		drainPty()
		handleInput()
		handleMouse(cw, ch)
		drawGrid(font, cwf, chf, cw, ch)
	}
	CloseWindow()
}
